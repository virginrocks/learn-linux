
Quadlet Container Service (systemd deprecated)
    Create quadlet file
        touch ~/.config/containers/systemd/nginx-lvm.container
        cat > ~/.config/containers/systemd/nginx-lvm.container << 'EOF'
        [Container]
        ContainerName=nginx-lvm
        Image=nginx:latest
        PublishPort=8081:80
        Volume=/mnt/lvdata/webroot:/usr/share/nginx/html:z
        [Unit]
        Description=Day 4 RHCSA nginx-lvm Quadlet
        After=network.target
        EOF

    Reload & enable
        systemctl --user daemon-reload
        systemctl --user start nginx-lvm
        systemctl --user status nginx-lvm

