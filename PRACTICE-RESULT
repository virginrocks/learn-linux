Day 4: SELinux/Containers (7 exercises)
	Toggle SELinux enforcing to permissive and back
		getenforce
		sudo setenforce 0
		getenforce
		setenforce 1

	Change Apache DocumentRoot to /webcontent and observe 403 denial
		sudo mkdir /webpractice && sudo sed -i 's/var\/www\/html/webpractice/g' /etc/httpd/conf/httpd.conf && cat /etc/httpd/conf/httpd.conf | grep webpractice
		crul -v practice-sysadmin.lan
		lzd /webpractice

	Fix Apache /webcontent access using semanage fcontext and restorecon
		ausearch -m AVC -ts recent | grep http
		sudo ls -Zd /webpractice
		sudo ls -Zd /var/www/html
		sudo semanage fcontext -a -t httpd_sys_content_t "/webpractice(/.*)?"
		sudo restorecon -Rv /webpractice
		lzd /webpractice
		sudo echo "<\!DOCTYPE html><head><i>Practice<i></head><body style='background-color: #DDDDDD;'><p>webpractice</p><p>/webpractice folder has been semanage and restorecon</p><p>$(date)@$(hostname)</p></body>" | sudo tee /webpractice/index.html

	Enable httpd_can_network_connect SELinux boolean
		getsebool -a | grep httpd
		sudo setebool -P httpd_can_network_connect on

	Run nginx container on port 8080 using podman
		podman pull nginx
		podman run -d --name practice-nginx -p 8080:80 nginx
		podman ps
		curl localhost:8080

	Mount /mnt/lvpractice/webroot volume into nginx container port 8081
		mkdir -p /mnt/lvpractice/webroot
		ls -Zd /mnt/lvpractice/webroot
		sudo chcon -Rt container_file_t /mnt/lvpractice/webroot
		sudo ls -Zd /mnt/lvpractice/webroot
		getsebool -a | grep container
		echo "<head>Practice</head><body style='background-color: #EEEEEE;'><p>podman nginx on LV</p><p>$(date)@$(hostname)</p></body>" | sudo tee /mnt/lvpractice/webroot/index.html
		sudo chown -R devi:devi /mnt/lvpractice
		podman run -d --name lvpractice-nginx -p 8083:80 -v /mnt/lvpractice/webroot:/usr/share/nginx/html:Z nginx
		curl practice-sysadmin.lan:8083

	Create systemd Quadlet for nginx-lvm container with persistent volume
    Content of /home/devi/.config/containers/systemd/lvpractice-nginx.container:
        [Container]
        ContainerName=lvpractice-nginx
        Image=nginx:latest
        PublishPort=8083:80
        Volume=/mnt/lvpractice/webroot:/usr/share/nginx/html:Z

        [Unit]
        Description=Practice LVM podman nginx container
        After=network.target
		systemctl --user daemon-reload
		systemctl --user start lvpractice-nginx
		podman ps
		curl $HOSTNAME:8083
