		sudo echo '#!/bin/bash \nsudo tar czf /mnt/practice/backup-lvpractice-$(date +%Y%m%d).tar.gz --directory /mnt/lvpractice . 2>/dev/null' | sudo tee /usr/local/bin/backup-lvpractice.sh

