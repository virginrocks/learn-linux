Day 1: Storage (6 exercises)
    Create partition on /dev/vdb1, format ext4, mount /mnt/practice manually
        ll /mnt 
        lsblk -fp 
        sudo fdisk /dev/sda (new part 2G) 
        sudo mkfs.ext4 /dev/sda7, 
        Add /dev/vdb1 to fstab using UUID for persistent mount
        sudo mkdir /mnt/practice && sudo chown -R devi:devi /mnt/practice && sudo mount /dev/sda7 /mnt/practice && df -h /mnt/practice 
        sudo cp /etc/fstab /mnt/practice/fstab-18-02-26.back 
        sudo chown -R devi:devi /mnt/practice 
        sudo blkid -s UUID -o value /dev/sda7 
        sudo echo 'UUID=7782a697-b5df-4c58-bdd9-84774851aeb1 /mnt/practice ext4 defaults,noatime 0 2' | sudo tee -a /etc/fstab && cat /etc/fstab 
        sudo systemctl daemon-reload 

    Add tmpfs RAM disk to fstab with size and mode options
        sudo umount /mnt/practice && sudo mount -a && sudo lsblk -fp | grep /dev/sda7 && sudo df -h /mnt/practice
        sudo mkdir /mnt/tmp2
        sudo echo tmpfs /mnt/tmp2 tmpfs defaults,noatime,mode=1777,size=512m 0 0 | sudo tee -a /etc/fstab && sudo cat /etc/fstab
        sudo systemctl daemon-reload 
        sudo mount -a && sudo mount | grep /mnt
        sudo df -hT tmp
        ls -lha /mnt/ | grep tmp2

    Create LVM PV VG LV on /dev/vdb2, format mount /mnt/lvpractice
        sudo fdisk /dev/sda (new part 5G)
        sudo pvcreate /dev/sda8 
        sudo vgcreate vgpractice /dev/sda8
        sudo lvcreate -L 3G vgpractice -n lvpractice
        sudo mkfs.xfs /dev/mapper/vgpractice-lvpractice
        sudo mkdir /mnt/lvpractice && sudo chown -R devi:devi /mnt/lvpractice
        sudo mount /dev/mapper/vgpractice-lvpractice /mnt/lvpractice && sudo mount | grep lvpractice
        df -hT /mnt/lvpractice
        sudo vgs | grep practice && sudo lvs | grep practice

    Extend LV from 3G to 4.5G and grow XFS filesystem online
        sudo lvextend -L +1.5G /dev/mapper/vgpractice-lvpractice
        sudo xfs_growfs /dev/vgpractice/lvpractice
        sudo lvs
        sudo blkid -s UUID -o value /dev/mapper/vgpractice-lvpractice
        sudo echo 'UUID=ff58a2cb-52f5-439f-aca9-00512734bd02 /mnt/lvpractice xfs defaults,noatime 0 2' | sudo tee -a /etc/fstab && sudo findmnt --verify
        sudo systemctl daemon-relaod
        sudo umount /mnt/lvpractice && sudo mount -a && sudo mount | grep lvpractice

    Set ACLs for practice user and devs group on /mnt/lvpractice plus quotas
        sudo useradd -u 1108 practice
        sudo usermod -aG devs practice
        id practice
        sudo setfacl -m u:practice:rwx /mnt/lvpractice
        sudo setfacl -m d:u:practice:rwx /mnt/lvpractice
        sudo setfacl -m g:devs:rx /mnt/lvpractice
        sudo setfacl -m d:g:devs:rx /mnt/lvpractice
        sudo getfacl /mnt/lvpractice
        sudo umount /mnt/lvpractice && sudo mount -t xfs -o "rw,uquota,gquota" /dev/mapper/vgpractice-lvpractice /mnt/lvpractice
        sudo findmnt --verify
        cat /etc/fstab
        sudo sed -i '29s/noatime/noatime,uquota,gquota/g' /etc/fstab && cat /etc/fstab
        sudo systemctl daemon-reload
        sudo mount -o remount /mnt/lvpractice
        sudo findmnt --verify
        sudo xfs_quota -x -c 'limit -u bsoft=120m bhard=125m practice' /mnt/lvpractice
        sudo xfs_quota -x -c 'report -h' /mnt/lvpractice
        sudo passwd practice
        su - practice
        dd bs=1M count=150 if=/dev/uandom of=/mnt/lvpractice/practice.file
        exit
        sudo xfs_quota -x -c 'report -h' /mnt/lvpractice

