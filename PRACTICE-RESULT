        sudo echo -e "[Unit] \nDescription=Run lvpractice backup daily at 2AM\n\n[Timer]\nOnCalendar=*_*_* 2:00:00\nPersistent=true\n\n[Install]\n\WantedBy=timers.target" | sudo tee /etc/systemd/system/backup-lvpractice.timer
