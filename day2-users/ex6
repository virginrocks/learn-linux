
systemd services - Timer

Script backup
    sudo vim /usr/local/bin/backup-lvdata.sh

        #!/bin/bash
        sudo tar czf /mnt/data/backup-lvdata-$(date +%d%m%Y).tar.gz --directory /mnt/lvdata . 2>/dev/null
        sudo echo "$(date): Backup complete" | sudo tee -a /var/log/backup.log

    sudo chmod +x /usr/local/bin/backup-lvadata.sh

systemd Service
    sudo vim /etc/systemd/system/backup-lvdata.service
        [unit]
        Description=Daily lvdata backup

        [Service]
        Type=oneshot
        User=root
        ExecStart=/usr/local/bin/backup-lvdata.sh

systemd Timer
    sudo vim /etc/systemd/system/backup-lvdata.timer
        [Unit]
        Description=Run lvdata backup daily

        [Timer]
        OnCalendar=daily
        Persistent=true

        [Install]
        WantedBy=timers.target

More data
    sudo setfacl -m u:bob:rwx /mnt/lvdata
    sudo setfacl -m d:u:bob:rwx /mnt/lvdata
    sudo getfacl /mnt/lvdata

    sudo xfs_quota -x -c 'limit -u bsoft=100m bhard=110m bob' /mnt/lvdata
    sudo xfs_quota -x -c 'report -h'

    ssh -i ~/.ssh/rhel_usb_key bob@192.168.1.62
        [bob]~ dd id=/dev/urandom of=/mnt/lvdata/bob.file bs=1M count=100

Enable - test
    sudo systemctl daemon-reload
    sudo systemctl enable --now backup-lvdata.timer
    sudo systemctl status backup-lvdata.timer
    sudo systemctl list-timers

Manual test
    sudo systemctl start backup_lvdata.service
    ls -lh /mnt/data/backup-lvdata-*.tar.gz
    tail /var/log/backup.log

